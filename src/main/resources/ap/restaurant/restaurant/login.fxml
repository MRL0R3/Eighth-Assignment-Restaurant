<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ap.restaurant.restaurant.Controller.LoginSignupController"
            stylesheets="@stl.css">

    <!-- Wrapper pane to center content -->
    <VBox alignment="CENTER" spacing="16.0" AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40" AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40">

        <Label text="Welcome Back 🍽️" styleClass="title-label"/>

        <TextField fx:id="usernameField" promptText="Username"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>

        <Label fx:id="errorLabel" text="" textFill="red" visible="false"/>

        <Button fx:id="loginButton" text="Login" onAction="#handleLogin"/>

        <Hyperlink text="Don't have an account? Sign Up" onAction="#goToSignup"/>
        <Button text="Logout" onAction="#logout"/>
    </VBox>
</AnchorPane>
