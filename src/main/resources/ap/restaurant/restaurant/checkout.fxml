<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ap.restaurant.restaurant.Controller.CheckOutController"
            stylesheets="@stl.css"
            prefWidth="600" prefHeight="400">

    <!-- CENTER: Receipt Table -->
    <VBox spacing="12" padding="20" BorderPane.alignment="CENTER">
        <Label text="🧾 Order Summary" styleClass="title-label"/>

        <TableView fx:id="receiptTable" prefHeight="250">
            <columns>
                <TableColumn fx:id="colItem" text="Item"/>
                <TableColumn fx:id="colQuantity" text="Quantity"/>
                <TableColumn fx:id="colUnitPrice" text="Price"/>
                <TableColumn fx:id="colTotal" text="Total"/>
            </columns>
        </TableView>

        <Label fx:id="totalLabel" text="Total: $0.00" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- BOTTOM: Action Buttons -->
    <HBox alignment="CENTER" spacing="16" padding="16" BorderPane.alignment="BOTTOM_CENTER">
        <Button text="Confirm Order" onAction="#confirmOrder"/>
        <Button text="Back to Menu" onAction="#backToMenu"/>
        <Button text="Logout" onAction="#logout"/>
    </HBox>
</BorderPane>
